#!name=网页去广告
#!desc=来源：limbopro/Adblock4limbo
#!author=提取自limbopro
#!homepage=https://github.com/limbopro/Adblock4limbo
#!icon=https://raw.githubusercontent.com/limbopro/Adblock4limbo/main/NobyDa.jpg

[Rule]
#相关广告域名
DOMAIN-SUFFIX,killcovid2021.com,REJECT
DOMAIN-KEYWORD,killcovid,REJECT

[Rewrite]
# 屏蔽部分常见广告资源
^https?:\/\/(img|vthumb)\.killcovid2021\.com.*?\.mp4 - reject
^https?:\/\/.*\.cdn77\.org\/.*\.mp4 - reject

[Script]
# 注入去广告脚本
http-response ^https?:\/\/\w{0,3}(\.){0,1}(91porn|91porna|91porny)\.com\/(?!(.*(get_image|slider_verify|cdn-cgi|register|cookie|captcha|evercookie|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf))))).* script-path=https://raw.githubusercontent.com/limbopro/Adblock4limbo/main/Adguard/Adblock4limbo.js, requires-body=true, timeout=30, tag=91porn去广告, enable=true

[MITM]
hostname = *.91porn.com, 91porn.com, www.91porn.com, 91porna.com, *.91porna.com, 91porny.com, *.91porny.com
