#!name = 航旅纵横开屏广告去除
#!desc = 去除航旅纵横 / 航旅纵横PRO 开屏广告。
#!author = 李白
#!homepage = 
#!icon = https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/umetrip.png
#!tag = 去广告
#!system = iOS
#!loon_version = 3.2.1

[Rule]
# 拦截广告素材域名
DOMAIN, oss.umetrip.com, REJECT
DOMAIN-SUFFIX, oss.umetrip.com, REJECT

[Script]
# 航旅纵横开屏广告拦截（通过 rpid 判断广告请求）
http-response ^https?:\/\/(home\.umetrip\.com|114\.115\.217\.129)\/gateway\/api\/umetrip\/native$ script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/umetrip/umetrip_ads.js, requires-body=true, timeout=10, tag=航旅纵横开屏

[MITM]
hostname = home.umetrip.com, 114.115.217.129, oss.umetrip.com
